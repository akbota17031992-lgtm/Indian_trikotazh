# Production Environment Configuration for API
NODE_ENV=production
PORT=4000

# Database Connection (Supabase Cloud or Kazakhstan VPS PostgreSQL)
DATABASE_URL=postgres://postgres:[DB_PASSWORD]@[DB_HOST]:5432/india_trikotaj_prod
DATABASE_SSL=true

# Security & Authentication
JWT_SECRET=[GENERATE_SECURE_RANDOM_256BIT_SECRET]
CORS_ORIGIN=https://indiatrikotaj.kz,https://admin.indiatrikotaj.kz

# Payment Gateway (Kaspi Pay via ApiPay.kz)
KASPI_GATEWAY=apipay
APIPAY_BASE_URL=https://api.apipay.kz/v1
APIPAY_API_KEY=[YOUR_APIPAY_SECRET_API_KEY]
APIPAY_MERCHANT_ID=[YOUR_KASPI_MERCHANT_ID]
APIPAY_WEBHOOK_SECRET=[YOUR_WEBHOOK_SECRET]

# Kazakhstan OFD Fiscalization (WebKassa / Re:Kassa)
WEBKASSA_API_URL=https://webkassa.kz/api/v2
WEBKASSA_LOGIN=[WEBKASSA_USER_LOGIN]
WEBKASSA_PASSWORD=[WEBKASSA_USER_PASSWORD]
WEBKASSA_CASHBOX_ID=[CASHBOX_NUMBER]

# Gemini Vision AI for Product Ingestion
GEMINI_API_KEY=[YOUR_GOOGLE_AI_STUDIO_KEY]

# Notification Gateways (Mobizon Kazakhstan SMS / WhatsApp)
MOBIZON_API_KEY=[OPTIONAL_MOBIZON_KEY]

