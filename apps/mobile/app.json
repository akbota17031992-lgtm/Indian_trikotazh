{
  "expo": {
    "name": "Индийский Трикотаж",
    "slug": "india-trikotaj",
    "owner": "dostiyar1992",
    "scheme": "indiatrikotaj",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#78350f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kz.indiatrikotaj.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Приложению необходим доступ к камере для сканирования штрихкодов в магазинах сети «Индийский Трикотаж».",
        "NSLocationWhenInUseUsageDescription": "Определение ближайшего к вам филиала «Индийский Трикотаж» в Алматы.",
        "NSFaceIDUsageDescription": "Используется для быстрой и безопасной биометрической авторизации в приложении по Face ID.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#78350f"
      },
      "package": "kz.indiatrikotaj.app",
      "allowBackup": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar"
    ],
    "extra": {
      "apiBaseUrl": "https://api.indiatrikotaj.kz"
    }
  }
}
