{
  "expo": {
    "name": "Индийский Трикотаж",
    "slug": "india-trikotaj",
    "scheme": "indiatrikotaj",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#78350f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kz.indiatrikotaj.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Приложению необходим доступ к камере для сканирования штрихкодов в магазинах сети «Индийский Трикотаж».",
        "NSLocationWhenInUseUsageDescription": "Определение ближайшего к вам филиала «Индийский Трикотаж» в Алматы."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#78350f"
      },
      "package": "kz.indiatrikotaj.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "india-trikotaj-almaty-2026"
      },
      "apiBaseUrl": "https://api.indiatrikotaj.kz"
    }
  }
}

