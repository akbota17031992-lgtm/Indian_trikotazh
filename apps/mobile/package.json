{
  "name": "@india-trikotaj/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:ios": "expo export -p ios --output-dir dist/ios",
    "build:android": "expo export -p android --output-dir dist/android",
    "build:all": "expo export -p all --output-dir dist",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@india-trikotaj/shared": "workspace:*",
    "expo": "~58.0.19",
    "expo-asset": "~11.1.0",
    "expo-local-authentication": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.2.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "4.1.0",
    "@india-trikotaj/config": "workspace:*",
    "@types/react": "~19.3.0",
    "typescript": "^5.7.2"
  }
