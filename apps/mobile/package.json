{
  "name": "@india-trikotaj/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "expo export -p ios --output-dir dist/ios",
    "build:android": "expo export -p android --output-dir dist/android",
    "build:all": "expo export -p all --output-dir dist",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@india-trikotaj/shared": "workspace:*",
    "expo": "~52.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@india-trikotaj/config": "workspace:*",
    "@types/react": "~18.3.12",
    "typescript": "^5.7.2"
  }
}

