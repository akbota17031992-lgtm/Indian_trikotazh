# Ensure consistent LF line endings across Windows and Linux
* text=auto eol=lf

# Explicitly preserve CRLF for Windows command scripts
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
