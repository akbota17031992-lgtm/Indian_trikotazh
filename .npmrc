# Monorepo resolution and peer management
auto-install-peers=true
strict-peer-dependencies=false
resolve-peers-from-workspace-root=true

# Windows cross-platform execution
shell-emulator=true

# Public hoist pattern for dev tools and TypeScript types
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@types*
public-hoist-pattern[]=tailwindcss
public-hoist-pattern[]=postcss

# Native binary prebuilts support (Sharp on Windows x64)
supportedArchitectures={"os":["win32","linux","darwin"],"cpu":["x64","arm64"]}

# Strict node engine enforcement
engine-strict=true
