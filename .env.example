# Application
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# PostgreSQL Database (Local Fallback & Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/india_trikotaj
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=india_trikotaj
POSTGRES_PORT=5432

# Supabase (Local Mock / Remote Cloud)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-anon-key-india-trikotaj-local-dev-2026
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key-india-trikotaj-local-dev-2026

# Meilisearch (Local Typo-Tolerant Search Engine)
MEILI_HOST=http://localhost:7700
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_PORT=7700
MEILISEARCH_MASTER_KEY=india_trikotaj_local_master_key_2026
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=india_trikotaj_local_master_key_2026

# Kaspi Pay Integration (ApiPay.kz Contract)
KASPI_MOCK_MODE=true
KASPI_PAY_MOCK_MODE=true
KASPI_PAY_API_URL=https://api.apipay.kz/v1
KASPI_PAY_MERCHANT_ID=mock_merchant_id
KASPI_PAY_SECRET_KEY=mock_secret_key_kaspi_2026

# AI Processing (Gemini Vision API)
GEMINI_API_KEY=
GEMINI_MOCK_MODE=true
